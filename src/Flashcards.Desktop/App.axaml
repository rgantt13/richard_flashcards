<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:local="clr-namespace:Flashcards.Desktop"
             xmlns:conv="clr-namespace:Flashcards.Desktop.Converters"
             x:Class="Flashcards.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <!-- Maps any ViewModel to its View by naming convention. See ViewLocator.cs. -->
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The ControlTheme for SubjectChip. See Controls/SubjectChip.cs. -->
                <ResourceInclude Source="avares://Flashcards.Desktop/Controls/Subjects/SubjectChip.axaml" />
                <ResourceInclude Source="avares://Flashcards.Desktop/Controls/Shared/AccuracyBar.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumToBoolConverter x:Key="EnumToBool" />
            <conv:NullToBoolConverter x:Key="NotNull" />
            <conv:CountToBoolConverter x:Key="AnyItems" />
            <conv:StretchConverter x:Key="Stretch" />
            <conv:ColorHexToBrushConverter x:Key="HexBrush" />
            <conv:ColorHexToTintBrushConverter x:Key="HexTint" />
            <conv:RelativeTimeConverter x:Key="RelativeTime" />
            <conv:CardTypeGlyphConverter x:Key="CardTypeGlyph" />
            <conv:CardTypeNameConverter x:Key="CardTypeName" />
            <conv:DepthToIndentConverter x:Key="DepthIndent" />
            <conv:InheritedOpacityConverter x:Key="InheritedOpacity" />
            <conv:InheritedTipConverter x:Key="InheritedTip" />
            <conv:ReviewToggleLabelConverter x:Key="ReviewToggleLabel" />
            <conv:ReviewToggleIconConverter x:Key="ReviewToggleIcon" />

            <!--
                Icons, as vector geometry rather than glyphs from an icon font.

                A character like ✎ or 🗑 depends on whatever font happens to cover that codepoint —
                on Windows that means falling out of Inter into Segoe UI Symbol, where some render
                as colour emoji and others as a missing-glyph box. Paths always draw the same
                thing, cost nothing to ship, and scale cleanly.

                All are on a 24x24 canvas so they line up at any size. They live here rather than
                in one view because more than one panel needs them — the manage grid's row actions
                and the designer's discard button both use the bin.
            -->
            <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
            <StreamGeometry x:Key="IconHistory">M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 1 1 7 7 6.96 6.96 0 0 1-4.95-2.05l-1.42 1.42A8.94 8.94 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z</StreamGeometry>
            <StreamGeometry x:Key="IconSuspend">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
            <StreamGeometry x:Key="IconDelete">M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
            <StreamGeometry x:Key="IconChevronDown">M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
            <StreamGeometry x:Key="IconChevronLeft">M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z</StreamGeometry>
            <StreamGeometry x:Key="IconChevronRight">M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
            <!--
                Import and export are the same arrow pointing opposite ways over a tray, which is
                what makes the pair readable at a glance without reading either label.
            -->
            <StreamGeometry x:Key="IconImport">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
            <StreamGeometry x:Key="IconExport">M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z</StreamGeometry>
            <!-- A funnel with a stroke through it: filtering, switched off. -->
            <StreamGeometry x:Key="IconFilterOff">M14.73 13.31 17.41 16 16 17.41l-2.69-2.69V21h-4v-8l-5.5-6.5H2.41L1 5.09 2.91 3.18l1.41 1.41L20.83 21.1l-1.41 1.41-4.69-4.69v-4.51zM6.4 4l4.6 5.44V10h1.2L18.6 4H6.4z</StreamGeometry>
            <conv:BoolToBrushConverter x:Key="SelectionBrush" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            Semi.Avalonia replaces the Fluent theme wholesale. Both are ResourceDictionary-driven,
            so a control's default template comes from whichever is loaded here; you override
            individual pieces below rather than retemplating.

            This is a control, not a StyleInclude. Early Semi.Avalonia was referenced as
            `avares://Semi.Avalonia/Themes/Index.axaml`; that resource no longer exists (the
            assembly's resource index maps SemiTheme to /SemiTheme.axaml), and an avares path that
            does not resolve is a BUILD error, because Avalonia compiles StyleInclude ahead of time.
        -->
        <!--
            Locale is a CultureInfo, and it is not optional in practice: when it is left unset
            SemiTheme falls back to `new CultureInfo("zh-CN")` and loads the Chinese resource
            dictionary. That fallback is also what threw CultureNotFoundException while
            InvariantGlobalization was on - constructing any non-invariant culture is illegal in
            that mode. Both halves are fixed: this is explicit, and the property is off in
            Directory.Build.props.
        -->
        <semi:SemiTheme Locale="en-US" />

        <!-- Fade/slide transitions for flyouts, combo box popups and tooltips. -->
        <semi:SemiPopupAnimations />

        <!-- Section headings used across the panels. -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Monospace surface for code blocks. -->
        <Style Selector="Border.codeSurface">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Application.Styles>

</Application>
