<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flashcards.Desktop.ViewModels.Design"
             xmlns:shared="clr-namespace:Flashcards.Desktop.ViewModels.Shared"
             xmlns:subjvm="clr-namespace:Flashcards.Desktop.ViewModels.Subjects"
             xmlns:controls="clr-namespace:Flashcards.Desktop.Controls.Shared"
             xmlns:subj="clr-namespace:Flashcards.Desktop.Controls.Subjects"
             xmlns:contracts="clr-namespace:Flashcards.Application.Contracts;assembly=Flashcards.Application"
             xmlns:cards="clr-namespace:Flashcards.Domain.Cards;assembly=Flashcards.Domain"
             x:DataType="vm:CardEditorViewModel"
             x:Class="Flashcards.Desktop.Views.Design.DesignerChoiceBoard">

    <!--
        A multiple-choice card: one question sheet, then four fixed answer slots that can each hold\n        text or a picture, with one or more marked correct.

        Shown by CardEditorView when the card type matches. Its DataContext is the same
        CardEditorViewModel, and the styles it draws with (sheet, element, faceLabel, addElement)
        are declared on CardEditorView and reach it by being an ancestor.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Flashcards.Desktop/Views/Design/DesignerResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

        <StackPanel IsVisible="{Binding IsMultipleChoice}">

            <Border Classes="sheet">
                <StackPanel>
                    <TextBlock Text="QUESTION" Classes="faceLabel" />
                    <ItemsControl ItemsSource="{Binding QuestionBlocks}"
                                  ItemTemplate="{StaticResource ElementTemplate}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="24,4,0,0">
                        <Button Classes="addElement" Content="+ text"
                                Command="{Binding AddBlockCommand}" CommandParameter="Question:Markdown" />
                        <Button Classes="addElement" Content="+ image"
                                Command="{Binding AddBlockCommand}" CommandParameter="Question:Image" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ANSWERS — tick the ring to mark one correct, drop an image on any tile"
                       Classes="muted" Margin="2,0,0,8" TextWrapping="Wrap" />

            <!--
                Exactly four tiles, always. An empty tile is a placeholder on the
                board and is dropped at save time, so the learner never sees a
                blank option.
            -->
            <ItemsControl ItemsSource="{Binding Choices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shared:ChoiceEditorViewModel">
                        <Border Classes="slot"
                                Classes.selected="{Binding IsActive}"
                                Classes.correct="{Binding IsCorrect}">
                            <DockPanel>

                                <!-- Slot header: letter badge, correct toggle, clear -->
                                <Grid DockPanel.Dock="Top"
                                      ColumnDefinitions="Auto,*,Auto,Auto"
                                      Margin="0,0,0,8">

                                    <Border Grid.Column="0"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource SemiColorFill1}">
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!--
                                        Picture controls live on the slot itself.
                                        They used to sit in the inspector, which is
                                        gone — without them a slot could only take
                                        an image by dragging a file in, losing
                                        clipboard paste entirely.
                                    -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal" Spacing="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Button Classes="handle"
                                                Content="IMG"
                                                FontSize="8"
                                                Width="28"
                                                ToolTip.Tip="Paste an image from the clipboard"
                                                Command="{Binding $parent[UserControl].((vm:CardEditorViewModel)DataContext).PasteChoiceImageCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="handle"
                                                Content="…"
                                                ToolTip.Tip="Choose an image file"
                                                Command="{Binding $parent[UserControl].((vm:CardEditorViewModel)DataContext).BrowseChoiceImageCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="handle"
                                                Content="⌫"
                                                ToolTip.Tip="Remove the image, keep the text"
                                                IsVisible="{Binding HasImage}"
                                                Command="{Binding $parent[UserControl].((vm:CardEditorViewModel)DataContext).ClearChoiceImageCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="2"
                                              Content="Correct"
                                              FontSize="11"
                                              IsChecked="{Binding IsCorrect, Mode=TwoWay}" />

                                    <Button Grid.Column="3"
                                            Classes="handle"
                                            Content="✕"
                                            ToolTip.Tip="Empty this slot"
                                            Command="{Binding $parent[UserControl].((vm:CardEditorViewModel)DataContext).ClearChoiceCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <!-- Picture, when the slot has one -->
                                <Panel DockPanel.Dock="Top" IsVisible="{Binding HasImage}">
                                    <controls:RichContentPresenter Blocks="{Binding ImagePreview}" />
                                </Panel>

                                <!-- Words -->
                                <TextBox Classes="canvasText"
                                         Text="{Binding Text, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         Watermark="Answer text, or drop an image" />

                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

</UserControl>
