<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flashcards.Desktop.ViewModels.Shared"
             xmlns:contracts="clr-namespace:Flashcards.Application.Contracts;assembly=Flashcards.Application"
             xmlns:ctrl="clr-namespace:Flashcards.Desktop.Controls.Shared"
             xmlns:subj="clr-namespace:Flashcards.Desktop.Controls.Subjects"
             x:DataType="vm:SubjectBrowserViewModel"
             x:Class="Flashcards.Desktop.Views.Shared.CardStatsCard">

    <!-- One card at size on the left, the list you pick from on the right. -->

    <UserControl.Styles>
        <StyleInclude Source="avares://Flashcards.Desktop/Views/Shared/StatCardStyles.axaml" />
    </UserControl.Styles>

            <Border Classes="card" Padding="0">
                <Grid ColumnDefinitions="*,18,340">

                    <!-- ··· the focused card, at size ··· -->
                    <DockPanel Grid.Column="0" Margin="18,14,0,14">
                        <TextBlock DockPanel.Dock="Top" Text="CARD" Classes="statLabel" Margin="0,0,0,12" />

                        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap"
                                   Text="Select a subject on the right of the tier above to choose cards from it."
                                   IsVisible="{Binding CardPicks.Count, Converter={StaticResource AnyItems}, ConverterParameter=invert}" />

                        <!-- One row, like the tier above: the mark, the card, the ring. -->
                        <Grid IsVisible="{Binding FocusedCard, Converter={StaticResource NotNull}}"
                              VerticalAlignment="Center">

                            <!--
                                The middle column is capped rather than sized to its text, so the
                                ring lands in the same place whichever row you pick. Left to fit
                                the name, it slid left and right as you moved down the list, which
                                reads as the page twitching rather than as a selection changing.
                                Still a star column underneath the cap, so a narrow window shrinks
                                it instead of pushing the ring off the edge.
                            -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <!--
                                    Nearly all the star weight, so this column takes the free space
                                    up to its cap and the sliver column at the end takes whatever
                                    is left. An even split between two plain star columns would
                                    hand half the room to the empty one.
                                -->
                                <ColumnDefinition Width="100*" MaxWidth="260" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Round and dotted, where a subject's mark is square and blocky. -->
                            <ctrl:Identicon Grid.Column="0"
                                            Variant="Card" Width="88" Height="88"
                                            VerticalAlignment="Center"
                                            Seed="{Binding FocusedCard.Id}" />

                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusedCard.Name}"
                                           FontSize="21" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />

                                <ItemsControl ItemsSource="{Binding FocusedCard.Subjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="contracts:SubjectRef">
                                            <subj:SubjectChip SubjectName="{Binding Name}" ColorHex="{Binding ColorHex}"
                                                              Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Spacing="14"
                                            IsVisible="{Binding FocusedCardStats.Practice.HasHistory}">
                                    <TextBlock Classes="muted"
                                               Text="{Binding FocusedCardStats.AverageSeconds, StringFormat='{}{0:0.#}s average'}" />
                                    <TextBlock Classes="muted"
                                               Text="{Binding FocusedCardStats.LastAnsweredUtc, Converter={StaticResource RelativeTime}, StringFormat='{}last answered {0}'}" />
                                </StackPanel>

                                <TextBlock Classes="muted" Text="Not answered yet."
                                           IsVisible="{Binding FocusedCardStats.Practice.HasHistory, Converter={StaticResource NotNull}, ConverterParameter=invert}" />

                            </StackPanel>

                            <!-- The same ring the subject tier uses, one level in. -->
                            <ctrl:AccuracyDonut Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Correct="{Binding FocusedCardStats.Practice.Correct}"
                                                Wrong="{Binding FocusedCardStats.Practice.Wrong}"
                                                CorrectBrush="{DynamicResource SemiColorSuccess}"
                                                WrongBrush="{DynamicResource SemiColorDanger}"
                                                TrackBrush="{DynamicResource SemiColorFill1}"
                                                TextBrush="{DynamicResource SemiColorText0}" />

                        </Grid>
                    </DockPanel>

                    <!-- ··· the picker ··· -->
                    <DockPanel Grid.Column="2" Margin="0,14,16,14">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{Binding CardListLabel}" Classes="statLabel" />
                                <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Text="{Binding CardListHint}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        IsVisible="{Binding ShowsSelection}">
                                <Button Classes="mini" Content="All" Command="{Binding SetAllCardsCommand}" CommandParameter="true" />
                                <Button Classes="mini" Content="None" Command="{Binding SetAllCardsCommand}" CommandParameter="false" />
                            </StackPanel>
                        </Grid>

                        <!--
                            Selecting a row focuses it for the readout on the left; the checkbox
                            is a separate gesture that puts it in the custom session. Inspecting
                            a card should not silently change what you study.
                        -->
                        <ListBox ItemsSource="{Binding CardPicks}"
                                 SelectedItem="{Binding FocusedCard, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CardPickViewModel">
                                    <Grid ColumnDefinitions="Auto,8,Auto,10,*,8,Auto" Margin="0,2">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsVisible="{Binding $parent[UserControl].((vm:SubjectBrowserViewModel)DataContext).ShowsSelection}"
                                                  IsChecked="{Binding IsIncluded, Mode=TwoWay}" />

                                        <ctrl:Identicon Grid.Column="2" Variant="Card"
                                                        Width="22" Height="22"
                                                        VerticalAlignment="Center"
                                                        Seed="{Binding Id}" />

                                        <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ctrl:AccuracyBar Classes="compact"
                                                              Correct="{Binding Practice.Correct}"
                                                              Wrong="{Binding Practice.Wrong}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="6" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding Practice.HasHistory}"
                                                   Text="{Binding Practice.Accuracy, StringFormat='{}{0:P0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
</UserControl>
