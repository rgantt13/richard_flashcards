<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flashcards.Desktop.ViewModels.Shared"
             xmlns:contracts="clr-namespace:Flashcards.Application.Contracts;assembly=Flashcards.Application"
             xmlns:ctrl="clr-namespace:Flashcards.Desktop.Controls.Shared"
             xmlns:subj="clr-namespace:Flashcards.Desktop.Controls.Subjects"
             x:DataType="vm:SubjectBrowserViewModel"
             x:Class="Flashcards.Desktop.Views.Shared.SubjectStatsCard">

    <!-- One subject at size on the left, the list you pick from on the right. -->

    <UserControl.Styles>
        <StyleInclude Source="avares://Flashcards.Desktop/Views/Shared/StatCardStyles.axaml" />
    </UserControl.Styles>

    <!--
        The subject you are looking at gets the left two thirds at full size — mark, name, headline
        bar, breakdown — and the list you pick from is squeezed into a narrow column on the right.
        The list used to own the whole width and every row carried its own bar, which meant twenty
        identical small bars and no single figure large enough to actually read.
    -->
            <Border Classes="card" Padding="0">
                <Grid ColumnDefinitions="*,18,340">

                    <!-- ··· the focused subject, at size ··· -->
                    <DockPanel Grid.Column="0" Margin="18,14,0,14">
                        <TextBlock DockPanel.Dock="Top" Text="SUBJECT" Classes="statLabel" Margin="0,0,0,12" />

                        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap"
                                   Text="No subjects yet. Tag a card on the Design panel and it will appear here."
                                   IsVisible="{Binding SubjectPicks.Count, Converter={StaticResource AnyItems}, ConverterParameter=invert}" />

                        <!--
                            One row: the mark, what you are looking at, and how it is going. The
                            figures that used to sit in a second row underneath are inside the ring
                            now, beside the segments they describe.
                        -->
                        <Grid IsVisible="{Binding FocusedSubject, Converter={StaticResource NotNull}}"
                              VerticalAlignment="Center">

                            <!--
                                The middle column is capped rather than sized to its text, so the
                                ring lands in the same place whichever row you pick. Left to fit
                                the name, it slid left and right as you moved down the list, which
                                reads as the page twitching rather than as a selection changing.
                                Still a star column underneath the cap, so a narrow window shrinks
                                it instead of pushing the ring off the edge.
                            -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <!--
                                    Nearly all the star weight, so this column takes the free space
                                    up to its cap and the sliver column at the end takes whatever
                                    is left. An even split between two plain star columns would
                                    hand half the room to the empty one.
                                -->
                                <ColumnDefinition Width="100*" MaxWidth="260" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ctrl:Identicon Grid.Column="0"
                                            Variant="Subject" Width="88" Height="88"
                                            VerticalAlignment="Center"
                                            Seed="{Binding FocusedSubject.Id}"
                                            AccentHex="{Binding FocusedSubject.ColorHex}" />

                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusedSubject.Name}"
                                           FontSize="21" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Classes="muted" Text="{Binding FocusedSubject.CardCountLabel}" />
                                    <TextBlock Classes="muted"
                                               Text="{Binding FocusedSubject.CardsUntouched, StringFormat='{}{0} never answered'}" />
                                </StackPanel>
                            </StackPanel>

                            <!--
                                The headline reading, opposite the mark. A ring rather than the bar
                                the rows use: this is one value being read, not twenty being
                                compared, and a ring has somewhere to put the number.
                            -->
                            <ctrl:AccuracyDonut Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Correct="{Binding FocusedSubject.Practice.Correct}"
                                                Wrong="{Binding FocusedSubject.Practice.Wrong}"
                                                CorrectBrush="{DynamicResource SemiColorSuccess}"
                                                WrongBrush="{DynamicResource SemiColorDanger}"
                                                TrackBrush="{DynamicResource SemiColorFill1}"
                                                TextBrush="{DynamicResource SemiColorText0}" />

                        </Grid>
                    </DockPanel>

                    <!-- ··· the picker ··· -->
                    <DockPanel Grid.Column="2" Margin="0,14,16,14">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{Binding SubjectListLabel}" Classes="statLabel" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="{Binding SubjectListHint}" />
                            </StackPanel>

                            <!-- Nothing to select all of when the rows are only being read. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        IsVisible="{Binding ShowsSelection}">
                                <Button Classes="mini" Content="All" Command="{Binding SetAllSubjectsCommand}" CommandParameter="true" />
                                <Button Classes="mini" Content="None" Command="{Binding SetAllSubjectsCommand}" CommandParameter="false" />
                            </StackPanel>
                        </Grid>

                        <!--
                            Selecting a row shows it on the left. Where a session is being put
                            together the checkbox beside it is the separate gesture that puts the
                            subject in that session — two questions, two controls. On the statistics
                            panel there is no second question, so the column is not there.
                        -->
                        <ListBox ItemsSource="{Binding SubjectPicks}"
                                 SelectedItem="{Binding FocusedSubject, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubjectPickViewModel">
                                    <!--
                                        Indent is a margin on the row rather than padding in the
                                        name, so a trimmed name keeps its nesting and the
                                        checkbox column stays a straight edge to aim at. Depth
                                        is capped at five, so this never runs past four steps.
                                    -->
                                    <Grid ColumnDefinitions="Auto,8,Auto,10,*,8,Auto" Margin="0,2">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsVisible="{Binding $parent[UserControl].((vm:SubjectBrowserViewModel)DataContext).ShowsSelection}"
                                                  IsChecked="{Binding IsIncluded, Mode=TwoWay}" />

                                        <ctrl:Identicon Grid.Column="2" Variant="Subject"
                                                        Width="22" Height="22"
                                                        VerticalAlignment="Center"
                                                        Margin="{Binding Indent}"
                                                        Seed="{Binding Id}"
                                                        AccentHex="{Binding ColorHex}" />

                                        <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Where a parent's own cards differ from its subtree total. -->
                                                <TextBlock FontSize="10" Opacity="0.45" VerticalAlignment="Center"
                                                           IsVisible="{Binding ShowsDirectCount}"
                                                           Text="{Binding DirectCardCount, StringFormat='{}{0} here'}" />
                                            </StackPanel>
                                            <ctrl:AccuracyBar Classes="compact"
                                                              Correct="{Binding Practice.Correct}"
                                                              Wrong="{Binding Practice.Wrong}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="6" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Cards in this subject and everything under it"
                                                   Text="{Binding CardCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
</UserControl>
