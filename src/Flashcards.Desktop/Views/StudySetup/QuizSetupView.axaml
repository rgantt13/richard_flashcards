<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flashcards.Desktop.ViewModels.Study"
             xmlns:pick="clr-namespace:Flashcards.Desktop.ViewModels.StudySetup"
             xmlns:contracts="clr-namespace:Flashcards.Application.Contracts;assembly=Flashcards.Application"
             xmlns:ctrl="clr-namespace:Flashcards.Desktop.Controls.Shared"
             xmlns:subj="clr-namespace:Flashcards.Desktop.Controls.Subjects"
             x:DataType="vm:QuizViewModel"
             x:Class="Flashcards.Desktop.Views.StudySetup.QuizSetupView">

    <!--
        Choosing what to study. Shown by QuizView while the session has not started.

        A tiered drill-down: the whole library as a header, then subjects, then the cards inside
        them, then the ways to start. Each tier both reports how you are doing and narrows what a
        custom session will contain, because those are the same decision.
    -->

    <UserControl.Styles>
        <!-- One statistic: a big number over a quiet label. -->
        <Style Selector="StackPanel.figure > TextBlock:nth-child(1)">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="StackPanel.figure > TextBlock:nth-child(2)">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- The library header sits slightly proud of the tiers beneath it. -->
        <Style Selector="Border.headerCard">
            <Setter Property="Padding" Value="22,18" />
        </Style>

        <!--
            All/None above a picker column. Small enough not to compete with the figures beside
            them — these are housekeeping, not the point of the tier.
        -->
        <Style Selector="Button.mini">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!--
            The three ways to start. Sized and coloured to be the obvious end of the page, and
            distinguished from each other by hue rather than by reading the label.
        -->
        <Style Selector="Button.start">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.start > StackPanel > TextBlock.startTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.start > StackPanel > TextBlock.startCaption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--
            Per-button colours. THIS is where the study buttons get their look — the markup below
            only tags each one with `Classes="start custom"`, the way an HTML element carries a
            class and the rules live in the stylesheet.

            To recolour a button, change the two setters in its block. Background is the fill;
            BorderBrush is the 1px edge (matching the fill makes the border disappear).
        -->
        <Style Selector="Button.start.custom">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
        </Style>

        <Style Selector="Button.start.random">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <Style Selector="Button.start.suggested">
            <Setter Property="Background" Value="{DynamicResource SemiColorSuccess}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorSuccess}" />
        </Style>

        <!--
            Text colour is set on the TextBlocks rather than on the Button.
            Foreground does inherit down the tree, so setting it on the Button would usually work —
            but targeting the text directly is unambiguous, and it is what the rest of this codebase
            does (see SubjectChip.axaml and the designer's move grip).

            The two saturated buttons pin their text to white so it stays legible whatever the
            theme does with its default foreground. `random` is deliberately left out: its fill is a
            subtle theme colour, so its text should keep following the theme too.
        -->
        <Style Selector="Button.start.custom TextBlock,
                         Button.start.suggested TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Reactive: lift on hover, settle on press, fade when there is nothing to start. -->
        <Style Selector="Button.start:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.start:pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)" />
        </Style>

        <Style Selector="Button.start:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.start">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,22">

        <!-- ····· tier 0: the whole library, as a header ····· -->
        <Border DockPanel.Dock="Top" Classes="card headerCard" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,28,*,28,Auto">

                <StackPanel Grid.Column="0" Spacing="0">
                    <TextBlock Text="{Binding Overall.Practice.Accuracy, StringFormat='{}{0:P0}'}"
                               FontSize="46" FontWeight="Bold" />
                    <TextBlock Text="answered correctly" Classes="muted" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                    <ctrl:AccuracyBar Classes="thick"
                                      Correct="{Binding Overall.Practice.Correct}"
                                      Wrong="{Binding Overall.Practice.Wrong}" />

                    <UniformGrid Columns="3">
                        <StackPanel Classes="figure" Spacing="1">
                            <TextBlock Text="{Binding Overall.Practice.Answered}" />
                            <TextBlock Text="answered" />
                        </StackPanel>
                        <StackPanel Classes="figure" Spacing="1">
                            <TextBlock Text="{Binding Overall.Practice.Correct}"
                                       Foreground="{DynamicResource SemiColorSuccess}" />
                            <TextBlock Text="right" />
                        </StackPanel>
                        <StackPanel Classes="figure" Spacing="1">
                            <TextBlock Text="{Binding Overall.Practice.Wrong}"
                                       Foreground="{DynamicResource SemiColorDanger}" />
                            <TextBlock Text="wrong" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="10" VerticalAlignment="Center">
                    <UniformGrid Columns="3">
                        <StackPanel Classes="figure" Spacing="1" Margin="0,0,18,0">
                            <TextBlock Text="{Binding Overall.TotalCards}" />
                            <TextBlock Text="cards" />
                        </StackPanel>
                        <StackPanel Classes="figure" Spacing="1" Margin="0,0,18,0">
                            <TextBlock Text="{Binding Overall.SubjectCount}" />
                            <TextBlock Text="subjects" />
                        </StackPanel>
                        <StackPanel Classes="figure" Spacing="1">
                            <TextBlock Text="{Binding Overall.CardsUntouched}" />
                            <TextBlock Text="untouched" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ····· the ways to start, pinned to the bottom ····· -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Spacing="10">

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource SemiColorDanger}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNull}}" />

                <Grid ColumnDefinitions="*,14,*,14,*">

                    <!-- built from the selections above -->
                    <Button Grid.Column="0" Classes="start custom"
                            Command="{Binding CustomStudyCommand}"
                            IsEnabled="{Binding CanStartCustom}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Custom Study" Classes="startTitle" />
                            <TextBlock Text="{Binding CustomSummary, StringFormat='{}exactly what you picked — {0}'}"
                                       Classes="startCaption" />
                        </StackPanel>
                    </Button>

                    <!-- quick modes, both drawing QuickCount from the whole library -->
                    <Button Grid.Column="2" Classes="start random"
                            Command="{Binding RandomStudyCommand}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Random Study" Classes="startTitle" />
                            <TextBlock Text="{Binding QuickCount, StringFormat='{}{0} cards, drawn at random'}"
                                       Classes="startCaption" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Classes="start suggested"
                            Command="{Binding SuggestedStudyCommand}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Suggested Study" Classes="startTitle" />
                            <TextBlock Text="{Binding QuickCount, StringFormat='{}{0} cards you get wrong most'}"
                                       Classes="startCaption" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- the count the two quick modes share -->
                <Grid ColumnDefinitions="Auto,12,260,12,Auto,*">
                    <TextBlock Grid.Column="0" Text="Quick session size" Classes="muted" VerticalAlignment="Center" />
                    <Slider Grid.Column="2" Minimum="5" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" Value="{Binding QuickCount, Mode=TwoWay}" />
                    <TextBlock Grid.Column="4" Text="{Binding QuickCount}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Width="34" />
                    <CheckBox Grid.Column="5" HorizontalAlignment="Right"
                              Content="Shuffle multiple-choice options"
                              IsChecked="{Binding ShuffleChoices, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ····· tiers 1 and 2 ····· -->
        <Grid RowDefinitions="*,14,*">

            <!--
                tier 1: subjects. The subject you are looking at gets the left two thirds at
                full size — mark, name, headline bar, breakdown — and the list you pick from is
                squeezed into a narrow column on the right. The list used to own the whole width
                and every row carried its own bar, which meant twenty identical small bars and
                no single figure large enough to actually read.
            -->
            <Border Grid.Row="0" Classes="card" Padding="0">
                <Grid ColumnDefinitions="*,18,340">

                    <!-- ··· the focused subject, at size ··· -->
                    <DockPanel Grid.Column="0" Margin="18,14,0,14">
                        <TextBlock DockPanel.Dock="Top" Text="SUBJECT" Classes="statLabel" Margin="0,0,0,12" />

                        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap"
                                   Text="No subjects yet. Tag a card on the Design panel and it will appear here."
                                   IsVisible="{Binding SubjectPicks.Count, Converter={StaticResource AnyItems}, ConverterParameter=invert}" />

                        <!--
                            Two rows, and the mark spans neither. An earlier cut had the
                            identicon spanning three auto rows, which left the grid distributing
                            its height across them and opened a hand's width of dead space
                            between the name and the bar. One row, sized by whichever of the two
                            columns is taller, has no such freedom.
                        -->
                        <Grid IsVisible="{Binding FocusedSubject, Converter={StaticResource NotNull}}"
                              ColumnDefinitions="Auto,18,*"
                              RowDefinitions="Auto,18,Auto"
                              VerticalAlignment="Center">

                            <ctrl:Identicon Grid.Row="0" Grid.Column="0"
                                            Variant="Subject" Width="88" Height="88"
                                            VerticalAlignment="Center"
                                            Seed="{Binding FocusedSubject.Id}"
                                            AccentHex="{Binding FocusedSubject.ColorHex}" />

                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding FocusedSubject.Name}"
                                               FontSize="21" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Classes="muted" Text="{Binding FocusedSubject.CardCountLabel}" />
                                        <TextBlock Classes="muted"
                                                   Text="{Binding FocusedSubject.CardsUntouched, StringFormat='{}{0} never answered'}" />
                                    </StackPanel>
                                </StackPanel>

                                <ctrl:AccuracyBar Classes="hero"
                                                  Correct="{Binding FocusedSubject.Practice.Correct}"
                                                  Wrong="{Binding FocusedSubject.Practice.Wrong}" />
                            </StackPanel>

                            <UniformGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Columns="4">
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedSubject.Practice.Accuracy, StringFormat='{}{0:P0}'}" />
                                    <TextBlock Text="correct" />
                                </StackPanel>
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedSubject.Practice.Correct}"
                                               Foreground="{DynamicResource SemiColorSuccess}" />
                                    <TextBlock Text="right" />
                                </StackPanel>
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedSubject.Practice.Wrong}"
                                               Foreground="{DynamicResource SemiColorDanger}" />
                                    <TextBlock Text="wrong" />
                                </StackPanel>
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedSubject.Practice.Answered}" />
                                    <TextBlock Text="answered" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </DockPanel>

                    <!-- ··· the picker ··· -->
                    <DockPanel Grid.Column="2" Margin="0,14,16,14">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="IN THIS SESSION" Classes="statLabel" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="{Binding SelectedSubjectCount, StringFormat='{}{0} selected'}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="mini" Content="All" Command="{Binding SetAllSubjectsCommand}" CommandParameter="true" />
                                <Button Classes="mini" Content="None" Command="{Binding SetAllSubjectsCommand}" CommandParameter="false" />
                            </StackPanel>
                        </Grid>

                        <!--
                            Selecting a row shows it on the left; the checkbox is the separate
                            gesture that puts it in the session. Two questions, two controls —
                            the same split the card tier below already uses.
                        -->
                        <ListBox ItemsSource="{Binding SubjectPicks}"
                                 SelectedItem="{Binding FocusedSubject, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="pick:SubjectPickViewModel">
                                    <!--
                                        Indent is a margin on the row rather than padding in the
                                        name, so a trimmed name keeps its nesting and the
                                        checkbox column stays a straight edge to aim at. Depth
                                        is capped at five, so this never runs past four steps.
                                    -->
                                    <Grid ColumnDefinitions="Auto,8,Auto,10,*,8,Auto" Margin="0,2">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsIncluded, Mode=TwoWay}" />

                                        <ctrl:Identicon Grid.Column="2" Variant="Subject"
                                                        Width="22" Height="22"
                                                        VerticalAlignment="Center"
                                                        Margin="{Binding Indent}"
                                                        Seed="{Binding Id}"
                                                        AccentHex="{Binding ColorHex}" />

                                        <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Where a parent's own cards differ from its subtree total. -->
                                                <TextBlock FontSize="10" Opacity="0.45" VerticalAlignment="Center"
                                                           IsVisible="{Binding ShowsDirectCount}"
                                                           Text="{Binding DirectCardCount, StringFormat='{}{0} here'}" />
                                            </StackPanel>
                                            <ctrl:AccuracyBar Classes="compact"
                                                              Correct="{Binding Practice.Correct}"
                                                              Wrong="{Binding Practice.Wrong}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="6" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Cards in this subject and everything under it"
                                                   Text="{Binding CardCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- tier 2: cards from those subjects — the same shape as the tier above. -->
            <Border Grid.Row="2" Classes="card" Padding="0">
                <Grid ColumnDefinitions="*,18,340">

                    <!-- ··· the focused card, at size ··· -->
                    <DockPanel Grid.Column="0" Margin="18,14,0,14">
                        <TextBlock DockPanel.Dock="Top" Text="CARD" Classes="statLabel" Margin="0,0,0,12" />

                        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap"
                                   Text="Select a subject on the right of the tier above to choose cards from it."
                                   IsVisible="{Binding CardPicks.Count, Converter={StaticResource AnyItems}, ConverterParameter=invert}" />

                        <Grid IsVisible="{Binding FocusedCard, Converter={StaticResource NotNull}}"
                              ColumnDefinitions="Auto,18,*"
                              RowDefinitions="Auto,18,Auto"
                              VerticalAlignment="Center">

                            <!-- Round and dotted, where a subject's mark is square and blocky. -->
                            <ctrl:Identicon Grid.Row="0" Grid.Column="0"
                                            Variant="Card" Width="88" Height="88"
                                            VerticalAlignment="Center"
                                            Seed="{Binding FocusedCard.Id}" />

                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusedCard.Name}"
                                           FontSize="21" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />

                                <ItemsControl ItemsSource="{Binding FocusedCard.Subjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="contracts:SubjectRef">
                                            <subj:SubjectChip SubjectName="{Binding Name}" ColorHex="{Binding ColorHex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Spacing="14"
                                            IsVisible="{Binding FocusedCardStats.Practice.HasHistory}">
                                    <TextBlock Classes="muted"
                                               Text="{Binding FocusedCardStats.AverageSeconds, StringFormat='{}{0:0.#}s average'}" />
                                    <TextBlock Classes="muted"
                                               Text="{Binding FocusedCardStats.LastAnsweredUtc, Converter={StaticResource RelativeTime}, StringFormat='{}last answered {0}'}" />
                                </StackPanel>

                                <TextBlock Classes="muted" Text="Not answered yet."
                                           IsVisible="{Binding FocusedCardStats.Practice.HasHistory, Converter={StaticResource NotNull}, ConverterParameter=invert}" />

                                <ctrl:AccuracyBar Classes="hero" Margin="0,6,0,0"
                                                  Correct="{Binding FocusedCardStats.Practice.Correct}"
                                                  Wrong="{Binding FocusedCardStats.Practice.Wrong}" />
                            </StackPanel>

                            <UniformGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Columns="4">
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedCardStats.Practice.Accuracy, StringFormat='{}{0:P0}'}" />
                                    <TextBlock Text="correct" />
                                </StackPanel>
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedCardStats.Practice.Correct}"
                                               Foreground="{DynamicResource SemiColorSuccess}" />
                                    <TextBlock Text="right" />
                                </StackPanel>
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedCardStats.Practice.Wrong}"
                                               Foreground="{DynamicResource SemiColorDanger}" />
                                    <TextBlock Text="wrong" />
                                </StackPanel>
                                <StackPanel Classes="figure" Spacing="1">
                                    <TextBlock Text="{Binding FocusedCardStats.Practice.Answered}" />
                                    <TextBlock Text="answered" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </DockPanel>

                    <!-- ··· the picker ··· -->
                    <DockPanel Grid.Column="2" Margin="0,14,16,14">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="IN THIS SESSION" Classes="statLabel" />
                                <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Text="{Binding CustomSummary, StringFormat='{}{0} — none ticked means all'}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="mini" Content="All" Command="{Binding SetAllCardsCommand}" CommandParameter="true" />
                                <Button Classes="mini" Content="None" Command="{Binding SetAllCardsCommand}" CommandParameter="false" />
                            </StackPanel>
                        </Grid>

                        <!--
                            Selecting a row focuses it for the readout on the left; the checkbox
                            is a separate gesture that puts it in the custom session. Inspecting
                            a card should not silently change what you study.
                        -->
                        <ListBox ItemsSource="{Binding CardPicks}"
                                 SelectedItem="{Binding FocusedCard, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="pick:CardPickViewModel">
                                    <Grid ColumnDefinitions="Auto,8,Auto,10,*,8,Auto" Margin="0,2">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsIncluded, Mode=TwoWay}" />

                                        <ctrl:Identicon Grid.Column="2" Variant="Card"
                                                        Width="22" Height="22"
                                                        VerticalAlignment="Center"
                                                        Seed="{Binding Id}" />

                                        <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ctrl:AccuracyBar Classes="compact"
                                                              Correct="{Binding Practice.Correct}"
                                                              Wrong="{Binding Practice.Wrong}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="6" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding Practice.HasHistory}"
                                                   Text="{Binding Practice.Accuracy, StringFormat='{}{0:P0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
