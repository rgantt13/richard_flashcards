<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Flashcards.Desktop.ViewModels.Study"
             xmlns:modes="clr-namespace:Flashcards.Desktop.ViewModels.StudySetup"
             x:DataType="vm:QuizViewModel"
             x:Class="Flashcards.Desktop.Views.StudySetup.StudyModeView">

    <!--
        How do you want to work? One tile per mode, and nothing else.

        This replaced a screen that showed the whole library, every subject and every card before
        you had said what you wanted to do with any of it. Most of that was only ever relevant to
        Custom, so it now lives on Custom's own prep screen and the other six open on the two or
        three options they actually have.

        The tiles are generated from StudyModeCard.All rather than written out one by one: which
        modes exist, what each is called and what each draws is a table in one place, and adding a
        mode should not mean editing markup as well.
    -->

    <UserControl.Styles>
        <Style Selector="Button.mode">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.mode:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.015)" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>

        <Style Selector="Button.mode:pressed">
            <Setter Property="RenderTransform" Value="scale(0.995)" />
        </Style>

        <Style Selector="TextBlock.modeTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TextBlock.modeBlurb">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A colour stripe down the left edge is the only thing distinguishing one tile's hue. -->
        <Style Selector="Border.accent">
            <Setter Property="Width" Value="4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,24">

        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,20">
            <TextBlock Text="Study" Classes="h1" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,16,0,0"
                   Foreground="{DynamicResource SemiColorDanger}"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNull}}" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Modes}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="modes:StudyModeCard">
                        <Button Classes="mode" Margin="0,0,12,12"
                                AutomationProperties.Name="{Binding Title}"
                                Command="{Binding $parent[UserControl].((vm:QuizViewModel)DataContext).ChooseModeCommand}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,14,Auto,14,*">
                                <Border Grid.Column="0" Classes="accent"
                                        Background="{Binding AccentKey, Converter={StaticResource ThemeBrush}}" />

                                <!--
                                    The mark takes the tile's own accent rather than the text
                                    colour, so the stripe and the icon read as one thing and the
                                    row of tiles is scannable by shape and hue together.
                                -->
                                <Path Grid.Column="2"
                                      Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                      Fill="{Binding AccentKey, Converter={StaticResource ThemeBrush}}"
                                      Width="26" Height="26" Stretch="Uniform"
                                      VerticalAlignment="Center" />

                                <StackPanel Grid.Column="4" Spacing="5">
                                    <TextBlock Text="{Binding Title}" Classes="modeTitle" />
                                    <TextBlock Text="{Binding Blurb}" Classes="modeBlurb" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
